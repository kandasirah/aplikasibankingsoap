@model AplikasiWebMethodSOAP.Models.DepositRequest
@{
    ViewData["Title"] = "Setor Tunai";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0"><i class="fas fa-arrow-down me-2"></i>Setor Tunai</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Deposit" method="post">
                    <div class="mb-3">
                        <label asp-for="AccountNumber" class="form-label">Nomor Akun</label>
                        <input asp-for="AccountNumber" class="form-control" placeholder="Masukkan nomor akun" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Amount" class="form-label">Jumlah Setoran</label>
                        <div class="input-group">
                            <span class="input-group-text">Rp</span>
                            <input asp-for="Amount" type="number" class="form-control" placeholder="0" min="1" />
                        </div>
                    </div>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-banking">
                            <i class="fas fa-check me-2"></i>Setor
                        </button>
                        <a href="/Banking" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Kembali
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
