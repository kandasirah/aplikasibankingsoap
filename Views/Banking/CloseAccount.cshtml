@{
    ViewData["Title"] = "Tutup Akun";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0"><i class="fas fa-user-times me-2"></i>Tutup Akun</h4>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Perhatian!</strong> Akun yang sudah ditutup tidak dapat dikembalikan. Pastikan saldo akun sudah 0.
                </div>
                <form asp-action="CloseAccount" method="post">
                    <div class="mb-3">
                        <label for="accountNumber" class="form-label">Nomor Akun</label>
                        <input type="text" name="accountNumber" class="form-control" placeholder="Masukkan nomor akun" required />
                    </div>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-times me-2"></i>Tutup Akun
                        </button>
                        <a href="/Banking" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Kembali
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
