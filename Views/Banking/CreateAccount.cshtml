@model AplikasiWebMethodSOAP.Models.CreateAccountRequest
@{
    ViewData["Title"] = "Buat Akun Baru";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0"><i class="fas fa-user-plus me-2"></i>Buat Akun Baru</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateAccount" method="post">
                    <div class="mb-3">
                        <label asp-for="AccountHolderName" class="form-label">Nama Pemegang Akun</label>
                        <input asp-for="AccountHolderName" class="form-control" placeholder="Masukkan nama lengkap" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="AccountType" class="form-label">Tipe Akun</label>
                        <select asp-for="AccountType" class="form-select">
                            <option value="">-- Pilih Tipe Akun --</option>
                            <option value="Savings">Tabungan</option>
                            <option value="Checking">Rekening Koran</option>
                            <option value="Deposito">Deposito</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="InitialBalance" class="form-label">Setoran Awal</label>
                        <div class="input-group">
                            <span class="input-group-text">Rp</span>
                            <input asp-for="InitialBalance" type="number" class="form-control" placeholder="0" min="0" />
                        </div>
                    </div>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-banking">
                            <i class="fas fa-plus me-2"></i>Buat Akun
                        </button>
                        <a href="/Banking" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Kembali
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
