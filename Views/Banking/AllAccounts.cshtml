@model List<AplikasiWebMethodSOAP.Models.Account>
@{
    ViewData["Title"] = "Daftar Akun";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="mb-0"><i class="fas fa-users me-2"></i>Daftar Semua Akun</h4>
        <a href="/Banking/CreateAccount" class="btn btn-light btn-sm">
            <i class="fas fa-plus me-1"></i>Buat Akun Baru
        </a>
    </div>
    <div class="card-body p-4">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                <p class="text-muted">Belum ada akun. Silakan buat akun baru.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Nomor Akun</th>
                            <th>Nama Pemegang</th>
                            <th>Tipe Akun</th>
                            <th>Saldo</th>
                            <th>Tanggal Dibuat</th>
                            <th>Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var account in Model)
                        {
                            <tr>
                                <td><span class="badge bg-primary">@account.AccountNumber</span></td>
                                <td>@account.AccountHolderName</td>
                                <td>@account.AccountType</td>
                                <td class="text-success fw-bold">@account.Balance.ToString("C")</td>
                                <td>@account.CreatedDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <a href="/Banking/AccountDetails?accountNumber=@account.AccountNumber" class="btn btn-sm btn-info">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="/Banking/Transactions?accountNumber=@account.AccountNumber" class="btn btn-sm btn-secondary">
                                        <i class="fas fa-history"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <div class="mt-3">
            <a href="/Banking" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Kembali
            </a>
        </div>
    </div>
</div>
